rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function image() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /products/{fichier} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role == 'super_admin'
        && image();
    }

    // Pièces d'identité des livreurs : déposées par le livreur, lues par lui et le super administrateur.
    match /kyc/{livreurId}/{fichier} {
      allow read: if request.auth != null
        && (request.auth.uid == livreurId || request.auth.token.role == 'super_admin');
      allow create: if request.auth != null
        && request.auth.uid == livreurId
        && request.auth.token.role == 'livreur'
        && image();
    }

    // Reçus de validation scannés au siège : envoyés par le correspondant, lus par l'administration.
    match /recus/{pays}/{lotId}/{fichier} {
      allow read: if request.auth != null
        && request.auth.token.role in ['correspondant', 'admin', 'super_admin'];
      allow create: if request.auth != null
        && resource == null
        && request.auth.token.role in ['correspondant', 'admin', 'super_admin']
        && image();
    }

    // Captures des paiements déclarés : déposées par leur auteur, lues par lui et l'administration.
    match /declarations/{uid}/{fichier} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.role in ['admin', 'super_admin']);
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == uid
        && request.auth.token.role in ['fbo', 'livreur']
        && image();
    }

    // Preuves de livraison : déposées par le livreur concerné, jamais remplacées.
    match /deliveries/{deliveryId}/{livreurId}/{fichier} {
      allow read: if request.auth != null
        && (request.auth.uid == livreurId
          || request.auth.token.role in ['operateur', 'gestionnaire_stock', 'admin', 'super_admin']);
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == livreurId
        && request.auth.token.role == 'livreur'
        && image();
    }
  }
}
