rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function role() { return connecte() ? request.auth.token.get('role', '') : ''; }
    function aRole(roles) { return role() in roles; }
    function estAdmin() { return aRole(['admin', 'super_admin']); }
    // Seul le super administrateur règle l'application (catalogue, tarifs, paramètres, comptes).
    function estSuperAdmin() { return role() == 'super_admin'; }
    // Pendant la maintenance, plus aucune écriture, sauf celles du super administrateur.
    function bloqueParMaintenance() {
      return !estSuperAdmin()
        && exists(/databases/$(database)/documents/parametres/maintenance)
        && get(/databases/$(database)/documents/parametres/maintenance).data.get('actif', false) == true;
    }
    function estPersonnel() {
      return aRole(['operateur', 'gestionnaire_stock', 'admin', 'super_admin']);
    }
    function aUnRole() {
      return aRole(['fbo', 'livreur', 'operateur', 'gestionnaire_stock', 'admin', 'super_admin']);
    }
    function moi(uid) { return connecte() && request.auth.uid == uid; }
    // Le personnel ne voit que son pays ; le super administrateur voit tout.
    function voitPays(pays) {
      return role() == 'super_admin'
        || (estPersonnel() && request.auth.token.get('pays', '') == pays);
    }
    function champsModifies() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Tout ce qui n'est pas autorisé explicitement ci-dessous est refusé.
    match /{document=**} {
      allow read, write: if false;
    }

    // Création et rôle : Cloud Functions uniquement.
    // L'utilisateur ne change que son nom et son email.
    match /users/{uid} {
      allow read: if moi(uid) || voitPays(resource.data.get('pays', ''));
      allow update: if moi(uid)
        && !bloqueParMaintenance()
        && champsModifies().hasOnly([
          // Le grade est attribué par l'administration : le distributeur ne fait qu'une demande.
          'nom', 'prenom', 'email', 'pays', 'ville', 'gradeDemande',
          'indicatifTelephone', 'telephone', 'indicatifWhatsapp', 'whatsapp',
          'objectifCC', 'objectifCA', 'idDistributeur'
        ])
        // L'ID Forever se renseigne une seule fois.
        && (!('idDistributeur' in champsModifies())
          || resource.data.get('idDistributeur', '') == '');
    }

    // Vitrine publique du FBO : uniquement ce qu'il choisit d'y montrer.
    match /boutiques/{uid} {
      allow read: if true;
      allow write: if moi(uid) && role() == 'fbo' && !bloqueParMaintenance();
    }

    // Le catalogue actif est public pour les boutiques en ligne.
    match /products/{id} {
      allow read: if resource.data.actif == true || aUnRole();
      allow write: if estSuperAdmin();
    }

    match /parametres/{id} {
      allow read: if aUnRole();
      allow write: if estSuperAdmin() && id != 'maintenance';
    }

    // L'état de maintenance est public : les applications l'affichent même avant la connexion.
    // Il ne change que par la fonction definirMaintenance (journalisée).
    match /parametres/maintenance {
      allow read: if true;
    }

    // Frais de livraison et commission du livreur : un document par pays, nommé d'après le pays.
    match /tarifsPays/{pays} {
      allow read: if aUnRole();
      allow write: if estSuperAdmin();
    }

    // Villes d'expédition et leurs frais, tenues par l'administration de chaque pays.
    match /villesExpedition/{id} {
      allow read: if aUnRole();
      allow write: if estSuperAdmin();
    }

    match /centres/{id} {
      allow read: if aUnRole();
      allow write: if estSuperAdmin();
    }

    match /warehouses/{id} {
      allow read: if estPersonnel();
      allow write: if estSuperAdmin();
    }

    // Stock et mouvements : écriture réservée aux Cloud Functions.
    match /stock/{id} {
      allow read: if voitPays(resource.data.get('pays', 'Burkina Faso'));
    }
    match /stockMovements/{id} {
      allow read: if estSuperAdmin();
    }

    match /customers/{id} {
      function clientValide() {
        return request.resource.data.nom is string
          && request.resource.data.nom.size() > 0
          && request.resource.data.nom.size() <= 120;
      }
      // Le carnet de clients appartient au distributeur : le personnel n'y a pas accès
      // (chaque commande garde sa propre copie des coordonnées utiles).
      allow read: if role() == 'fbo' && resource.data.ownerId == request.auth.uid;
      allow create: if role() == 'fbo'
        && !bloqueParMaintenance()
        && request.resource.data.ownerId == request.auth.uid
        && clientValide();
      allow update: if role() == 'fbo'
        && !bloqueParMaintenance()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && clientValide();
      allow delete: if role() == 'fbo' && !bloqueParMaintenance() && resource.data.ownerId == request.auth.uid;
    }

    // Commandes : prix et statuts sont gérés côté serveur, aucune écriture cliente.
    match /orders/{id} {
      allow read: if voitPays(resource.data.get('pays', 'Burkina Faso'))
        || (role() == 'fbo' && resource.data.fboId == request.auth.uid)
        || (role() == 'livreur' && resource.data.livreurId == request.auth.uid);
    }

    // Le livreur assigné ne met à jour que sa position GPS.
    match /deliveries/{id} {
      allow read: if voitPays(resource.data.get('pays', 'Burkina Faso'))
        || (role() == 'livreur' && resource.data.livreurId == request.auth.uid)
        || (role() == 'fbo' && resource.data.fboId == request.auth.uid);
      allow update: if role() == 'livreur'
        && !bloqueParMaintenance()
        && resource.data.livreurId == request.auth.uid
        && champsModifies().hasOnly(['position', 'positionUpdatedAt']);
    }

    match /notifications/{id} {
      allow read: if connecte() && resource.data.userId == request.auth.uid;
      allow update: if connecte()
        && resource.data.userId == request.auth.uid
        && champsModifies().hasOnly(['lu']);
    }

    // Jetons d'appareil : chacun n'enregistre que le sien, seules les fonctions les lisent.
    match /fcmTokens/{token} {
      allow create, update: if connecte() && request.resource.data.userId == request.auth.uid;
      allow delete: if connecte() && resource.data.userId == request.auth.uid;
    }

    match /auditLogs/{id} {
      allow read: if estSuperAdmin();
    }

    // userSecrets (empreintes de PIN) : aucune règle, donc jamais lisible par un client.
  }
}
